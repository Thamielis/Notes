3,0.0182274,0.00499922,0.00529411,0.01446407,-0.01083809,0.01634804,0.11407835,-0.10870736,0.02838428,0.02436034,0.20240393,-0.01004204,0.01141175,0.03180723,0.02541007,-0.00181943,0.10786656,0.06050302,0.01088884,0.02998571,0.07990243,0.02644752,0.04864051,-0.01362988,-0.09249596,0.05985185,0.01698923,-0.0061988,-0.01449528,-0.01812738,-0.01786812,0.02592818,0.08669039,-0.07122753,-0.02215554,-0.00801218,-0.03320609,0.02652783,-0.03510289,0.0308675,0.00563527,-0.00711978,-0.01579346,0.01360626,0.00771756,-0.06178523,0.00306287,-0.01254716,0.01297526,-0.01810553,0.07040546,0.03821058,-0.03068054],"last_embed":{"tokens":475,"hash":"up5d5v"}}},"last_read":{"hash":"up5d5v","at":1780754254544},"class_name":"SmartSource","last_import":{"mtime":1780748670065,"size":3373,"at":1780751809775,"hash":"up5d5v"},"blocks":{"#---frontmatter---":[1,6],"#Set-PSAnsiFileMap":[8,166],"#Set-PSAnsiFileMap#SYNOPSIS":[10,13],"#Set-PSAnsiFileMap#SYNOPSIS#{1}":[12,13],"#Set-PSAnsiFileMap#SYNTAX":[14,20],"#Set-PSAnsiFileMap#SYNTAX#{1}":[16,20],"#Set-PSAnsiFileMap#DESCRIPTION":[21,24],"#Set-PSAnsiFileMap#DESCRIPTION#{1}":[23,24],"#Set-PSAnsiFileMap#EXAMPLES":[25,42],"#Set-PSAnsiFileMap#EXAMPLES#Example 1":[27,34],"#Set-PSAnsiFileMap#EXAMPLES#Example 1#{1}":[29,34],"#Set-PSAnsiFileMap#EXAMPLES#Example 2":[35,42],"#Set-PSAnsiFileMap#EXAMPLES#Example 2#{1}":[37,42],"#Set-PSAnsiFileMap#PARAMETERS":[43,146],"#Set-PSAnsiFileMap#PARAMETERS#-Ansi":[45,60],"#Set-PSAnsiFileMap#PARAMETERS#-Ansi#{1}":[47,60],"#Set-PSAnsiFileMap#PARAMETERS#-Confirm":[61,76],"#Set-PSAnsiFileMap#PARAMETERS#-Confirm#{1}":[63,76],"#Set-PSAnsiFileMap#PARAMETERS#-Description":[77,93],"#Set-PSAnsiFileMap#PARAMETERS#-Description#{1}":[79,93],"#Set-PSAnsiFileMap#PARAMETERS#-PassThru":[94,109],"#Set-PSAnsiFileMap#PARAMETERS#-PassThru#{1}":[96,109],"#Set-PSAnsiFileMap#PARAMETERS#-Pattern":[110,125],"#Set-PSAnsiFileMap#PARAMETERS#-Pattern#{1}":[112,125],"#Set-PSAnsiFileMap#PARAMETERS#-WhatIf":[126,142],"#Set-PSAnsiFileMap#PARAMETERS#-WhatIf#{1}":[128,142],"#Set-PSAnsiFileMap#PARAMETERS#CommonParameters":[143,146],"#Set-PSAnsiFileMap#PARAMETERS#CommonParameters#{1}":[145,146],"#Set-PSAnsiFileMap#INPUTS":[147,150],"#Set-PSAnsiFileMap#INPUTS#None":[149,150],"#Set-PSAnsiFileMap#OUTPUTS":[151,154],"#Set-PSAnsiFileMap#OUTPUTS#PSAnsiFileEntry":[153,154],"#Set-PSAnsiFileMap#NOTES":[155,158],"#Set-PSAnsiFileMap#NOTES#{1}":[157,158],"#Set-PSAnsiFileMap#RELATED LINKS":[159,166],"#Set-PSAnsiFileMap#RELATED LINKS#{1}":[161,166]},"outlinks":[{"title":"38;5;190m\"\r\n```\r\n\r\nUpdate the ANSI pattern for temporary files. This change will not persist unless you export the map.\r\n\r\n### Example 2\r\n\r\n```powershell\r\nPS C:\\> Set-PSAnsiFileMap -Description \"Config\" -Pattern \"\\.(yml)$\" -Ansi \"`e[38;5;25m\"ge\r\n```\r\n\r\nAdd a new PSAnsiFileMap entry. This change will not persist unless you export the map.\r\n\r\n## PARAMETERS\r\n\r\n### -Ansi\r\n\r\nSpecify an ANSI escape sequence. You only need to define the opening sequence.\r\n\r\n```yaml\r\nType: String\r\nParameter Sets: (All)\r\nAliases:\r\n\r\nRequired: False\r\nPosition: Named\r\nDefault value: None\r\nAccept pipeline input: False\r\nAccept wildcard characters: False\r\n```\r\n\r\n### -Confirm\r\n\r\nPrompts you for confirmation before running the cmdlet.\r\n\r\n```yaml\r\nType: SwitchParameter\r\nParameter Sets: (All)\r\nAliases: cf\r\n\r\nRequired: False\r\nPosition: Named\r\nDefault value: None\r\nAccept pipeline input: False\r\nAccept wildcard characters: False\r\n```\r\n\r\n### -Description\r\n\r\nSpecify the file map entry.\r\nIf it is a new entry it will be added.\r\n\r\n```yaml\r\nType: String\r\nParameter Sets: (All)\r\nAliases:\r\n\r\nRequired: True\r\nPosition: 0\r\nDefault value: None\r\nAccept pipeline input: False\r\nAccept wildcard characters: False\r\n```\r\n\r\n### -PassThru\r\n\r\nDisplay the updated map.\r\n\r\n```yaml\r\nType: SwitchParameter\r\nParameter Sets: (All)\r\nAliases:\r\n\r\nRequired: False\r\nPosition: Named\r\nDefault value: None\r\nAccept pipeline input: False\r\nAccept wildcard characters: False\r\n```\r\n\r\n### -Pattern\r\n\r\nSpecify a regular expression pattern for the file name.\r\n\r\n```yaml\r\nType: String\r\nParameter Sets: (All)\r\nAliases:\r\n\r\nRequired: False\r\nPosition: Named\r\nDefault value: None\r\nAccept pipeline input: False\r\nAccept wildcard characters: False\r\n```\r\n\r\n### -WhatIf\r\n\r\nShows what would happen if the cmdlet runs.\r\nThe cmdlet is not run.\r\n\r\n```yaml\r\nType: SwitchParameter\r\nParameter Sets: (All)\r\nAliases: wi\r\n\r\nRequired: False\r\nPosition: Named\r\nDefault value: None\r\nAccept pipeline input: False\r\nAccept wildcard characters: False\r\n```\r\n\r\n### CommonParameters\r\n\r\nThis cmdlet supports the common parameters: -Debug, -ErrorAction, -ErrorVariable, -InformationAction, -InformationVariable, -OutVariable, -OutBuffer, -PipelineVariable, -Verbose, -WarningAction, and -WarningVariable. For more information, see [about_CommonParameters","target":"http://go.microsoft.com/fwlink/?LinkID=113216","line":30},{"title":"Get-PSAnsiFileMap","target":"Get-PSAnsiFileMap.md","line":161},{"title":"Remove-PSAnsiFileEntry","target":"Remove-PSAnsiFileEntry.md","line":163},{"title":"Export-PSAnsiFileMap","target":"Export-PSAnsiFileMap.md","line":165}],"metadata":{"external help file":"PSScriptTools-help.xml","Module Name":"PSScriptTools","online version":"https://bit.ly/394kL8m","schema":"2.0.0"},"task_lines":[],"tasks":{},"codeblock_ranges":[[16,19],[29,31],[37,39],[49,59],[65,75],[82,92],[98,108],[114,124],[131,141]],"key":"docs/PSModulesHelp/PSScriptTools/Set-PSAnsiFileMap.md"},
