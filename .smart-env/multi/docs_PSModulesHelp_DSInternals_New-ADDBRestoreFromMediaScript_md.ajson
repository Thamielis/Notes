2,0.02884607,-0.05874137,0.00362597,-0.03301635,0.02461376,0.02416212,0.04406632,0.03536279,-0.11864041,0.02231119,-0.00997448,0.17284328,0.00161036,0.00223606,0.03863294,-0.01543636,0.03545514,0.00746497,-0.01560776,0.00931937,0.01179687,0.07438075,-0.03636874,0.058586,-0.01867808,-0.02998439,0.03632075,0.02104695,-0.02423158,-0.07624228,-0.00372821,-0.02165032,0.04507509,0.05553371,-0.02784486,0.0195925,-0.06567959,0.06835437,0.10260869,-0.04870154,-0.0102225,0.06475569,-0.00329443,0.03600021,0.02008829,-0.04343232,0.01617192,0.01859914,-0.00395634,0.02620552,-0.02006484,0.04992537,0.05227477,-0.02420687],"last_embed":{"tokens":496,"hash":"tn1vw8"}}},"last_read":{"hash":"tn1vw8","at":1780752126726},"class_name":"SmartSource","last_import":{"mtime":1780748666685,"size":18101,"at":1780751805431,"hash":"tn1vw8"},"blocks":{"#":[1,3],"###Synopsis":[4,8],"###Synopsis#{1}":[5,8],"###Description":[9,62],"###Description#{1}":[11,62],"###Related Links":[63,71],"###Related Links#{1}":[64,71],"###Examples":[72,105],"###Examples#{1}":[73,105],"#Perform a VSS backup before doing anything else.":[106,109],"#Perform a VSS backup before doing anything else.#{1}":[107,109],"#The PS module must be present as workflows cannot contain non-existing activities.":[110,113],"#The PS module must be present as workflows cannot contain non-existing activities.#{1}":[111,113],"#All the other operations will be executed by a restartable workflow running in SYSTEM context.":[114,116],"#All the other operations will be executed by a restartable workflow running in SYSTEM context.#{1}":[115,116],"#Delete any pre-existing scheduled jobs with the same names before registering new ones.":[117,119],"#Delete any pre-existing scheduled jobs with the same names before registering new ones.#{1}":[118,119],"#The DSInternals-RFM-Initializer job will only be executed once in order to register the workflow and to invoke it for the first time.":[120,125],"#The DSInternals-RFM-Initializer job will only be executed once in order to register the workflow and to invoke it for the first time.#{1}":[121,125],"#A server rename operation is required.":[126,128],"#A server rename operation is required.#{1}":[127,128],"#We explicitly suspend the workflow as Restart-Computer with the -Wait parameter does not survive local reboots.":[129,135],"#We explicitly suspend the workflow as Restart-Computer with the -Wait parameter does not survive local reboots.#{1}":[130,135],"#A DC promotion is required.":[136,136],"#Note: In order to maintain compatibility with Windows Server 2008 R2, the ADDSDeployment module is not used.":[137,137],"#Advice: It is recommenced to change the DSRM password after DC promotion.":[138,159],"#Advice: It is recommenced to change the DSRM password after DC promotion.#{1}":[139,159],"#Reboot the computer into the Directory Services Restore Mode.":[160,164],"#Reboot the computer into the Directory Services Restore Mode.#{1}":[161,164],"#Re-encrypt the DB with the new boot key.":[165,168],"#Re-encrypt the DB with the new boot key.#{1}":[166,168],"#Clone the DC account password.":[169,171],"#Clone the DC account password.#{1}":[170,171],"#Note: SupplementalCredentials do not get serialized properly without using the InlineScript activity.":[172,176],"#Note: SupplementalCredentials do not get serialized properly without using the InlineScript activity.#{1}":[173,176],"#Replace the database and transaction logs.":[177,180],"#Replace the database and transaction logs.#{1}":[178,180],"#Replace SYSVOL.":[181,183],"#Replace SYSVOL.#{1}":[182,183],"#Reconfigure LSA policies. We would get into a BSOD loop if they do not match the corresponding values in the database.":[184,186],"#Reconfigure LSA policies. We would get into a BSOD loop if they do not match the corresponding values in the database.#{1}":[185,186],"#Tell the DC that its DB has intentionally been restored. A new InvocationID will be generated as soon as the service starts.":[187,190],"#Tell the DC that its DB has intentionally been restored. A new InvocationID will be generated as soon as the service starts.#{1}":[188,190],"#Disable DSRM and do one last reboot.":[191,195],"#Disable DSRM and do one last reboot.#{1}":[192,195],"#Reconfigure SYSVOL replication in case it has been restored to a different path.":[196,197],"#Update DFS-R subscription if present in AD.":[198,206],"#Update DFS-R subscription if present in AD.#{1}":[199,206],"#Download the updated DFS-R configuration from AD.":[207,210],"#Download the updated DFS-R configuration from AD.#{1}":[208,210],"#Update FRS subscription if present in AD.":[211,219],"#Update FRS subscription if present in AD.#{1}":[212,219],"#Download the updated FRS configuration from AD.":[220,224],"#Download the updated FRS configuration from AD.#{1}":[221,224],"#Delete any pre-existing workflows with the same name before starting a new one.":[225,227],"#Delete any pre-existing workflows with the same name before starting a new one.#{1}":[226,227],"#Start the workflow.":[228,231],"#Start the workflow.#{1}":[229,231],"#The DSInternals-RFM-Resumer job will be executed after each reboot to unpause the workflow.":[232,233],"#The DSInternals-RFM-Resumer job will be executed after each reboot to unpause the workflow.#{1}":[233,233],"#Unregister the one-time task that must already have been executed.":[234,236],"#Unregister the one-time task that must already have been executed.#{1}":[235,236],"#Resume the workflow after the computer is rebooted.":[237,238],"#Resume the workflow after the computer is rebooted.#{1}":[238,238],"#Perform cleanup when finished.":[239,244],"#Perform cleanup when finished.#{1}":[240,244],"#Configure the scheduled tasks to run under the SYSTEM account.":[245,245],"#Note: In order to maintain compatibility with Windows Server 2008 R2, the ScheduledTasks module is not used.":[246,249],"#Note: In order to maintain compatibility with Windows Server 2008 R2, the ScheduledTasks module is not used.#{1}":[247,249],"#Start the workflow task and let the magic happen.":[250,314],"#Start the workflow task and let the magic happen.#{1}":[251,256],"#Start the workflow task and let the magic happen.##Parameters":[257,294],"#Start the workflow task and let the magic happen.##Parameters#**BootKey**":[258,264],"#Start the workflow task and let the magic happen.##Parameters#**BootKey**#{1}":[259,264],"#Start the workflow task and let the magic happen.##Parameters#**DatabasePath**":[265,271],"#Start the workflow task and let the magic happen.##Parameters#**DatabasePath**#{1}":[266,271],"#Start the workflow task and let the magic happen.##Parameters#**LogPath**":[272,278],"#Start the workflow task and let the magic happen.##Parameters#**LogPath**#{1}":[273,278],"#Start the workflow task and let the magic happen.##Parameters#**SafeModeAdministratorPassword**":[279,285],"#Start the workflow task and let the magic happen.##Parameters#**SafeModeAdministratorPassword**#{1}":[280,285],"#Start the workflow task and let the magic happen.##Parameters#**SysvolPath**":[286,294],"#Start the workflow task and let the magic happen.##Parameters#**SysvolPath**#{1}":[287,294],"#Start the workflow task and let the magic happen.##Inputs":[295,299],"#Start the workflow task and let the magic happen.##Inputs#{1}":[296,299],"#Start the workflow task and let the magic happen.##Outputs":[300,304],"#Start the workflow task and let the magic happen.##Outputs#{1}":[301,304],"#Start the workflow task and let the magic happen.##Notes":[305,309],"#Start the workflow task and let the magic happen.##Notes#{1}":[306,309],"#Start the workflow task and let the magic happen.##Syntax":[310,314],"#Start the workflow task and let the magic happen.##Syntax#{1}":[311,314]},"outlinks":[{"title":"IFM backup","target":"https://docs.microsoft.com/en-us/previous-versions/windows/it-pro/windows-server-2008-R2-and-2008/cc816574(v=ws.10","line":13},{"title":"Online Version:","target":"https://github.com/MichaelGrafnetter/DSInternals/blob/master/