 to a specific path#{1}":[72,73],"#This is the default, but specified for clarity...":[74,76],"#This is the default, but specified for clarity...#{1}":[75,76],"#Parameters specific to our PSGalleryModule dependency type":[77,78],"#Parameters specific to our PSGalleryModule dependency type#{1}":[78,78],"#We want to install from an internal repository named MyPSGalleryRepository, that I've already registered":[79,82],"#We want to install from an internal repository named MyPSGalleryRepository, that I've already registered#{1}":[80,82],"#Tag it.  Maybe only install in certain scenarios":[83,85],"#Tag it.  Maybe only install in certain scenarios#{1}":[84,85],"#Add to the PSModulePath":[86,88],"#Add to the PSModulePath#{1}":[87,88],"#Make sure buildhelpers installs first":[89,91],"#Make sure buildhelpers installs first#{1}":[90,91],"#Run this script after installing the module":[92,151],"#Run this script after installing the module#{1}":[93,151]},"outlinks":[],"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"docs/PSModulesHelp/PSDepend/about_PSDepend_Definitions.md"},
