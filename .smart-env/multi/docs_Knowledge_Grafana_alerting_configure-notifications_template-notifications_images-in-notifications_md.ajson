Advanced configuration":[80,83],"#are persisted to disk for up to temp_data_lifetime.#Advanced configuration#{1}":[82,83],"#The maximum number of screenshots that can be taken at the same time. This option is different from":[84,84],"#concurrent_render_request_limit as max_concurrent_screenshots sets the number of concurrent screenshots":[85,85],"#that can be taken at the same time for all firing alerts where as concurrent_render_request_limit sets":[86,86],"#the total number of concurrent screenshots across all Grafana services.":[87,144],"#the total number of concurrent screenshots across all Grafana services.#{1}":[88,89],"#the total number of concurrent screenshots across all Grafana services.#Supported contact points":[90,113],"#the total number of concurrent screenshots across all Grafana services.#Supported contact points#{1}":[92,113],"#the total number of concurrent screenshots across all Grafana services.#Limitations":[114,120],"#the total number of concurrent screenshots across all Grafana services.#Limitations#{1}":[116,120],"#the total number of concurrent screenshots across all Grafana services.#Troubleshooting":[121,131],"#the total number of concurrent screenshots across all Grafana services.#Troubleshooting#{1}":[123,131],"#the total number of concurrent screenshots across all Grafana services.#Metrics":[132,144],"#the total number of concurrent screenshots across all Grafana services.#Metrics#{1}":[134,144]},"outlinks":[{"title":"opening a support ticket in the Cloud Portal","target":"/profile/org#support","line":23},{"title":"disabling images in notifications","target":"#configuration","line":48},{"title":"integrations which support uploading images","target":"#supported-contact-points","line":48},{"title":"disabling images in notifications","target":"#configuration","line":54},{"title":"integrations which support uploading images","target":"#supported-contact-points","line":54},{"title":"opening a support ticket in the Cloud Portal","target":"/profile/org#support","line":61}],"metadata":{"aliases":["../manage-notifications/images-in-notifications/"],"canonical":"https://grafana.com/docs/grafana/latest/alerting/configure-notifications/template-notifications/images-in-notifications/","description":"Use images in notifications to help users better understand why alerts are firing or have been resolved","keywords":["grafana","alerting","images","notifications"],"labels":{"products":["cloud","enterprise","oss"]},"title":"Use images in notifications","weight":500},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"docs/Knowledge/Grafana/alerting/configure-notifications/template-notifications/images-in-notifications.md"},
